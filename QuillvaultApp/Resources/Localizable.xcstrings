      }
    },
    "actionButton.result.cancelled" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Recording was not started." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "录音未开始。" } }
      }
    },
    "actionButton.result.directory" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Choose or reauthorize the meeting folder in the app." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "请在应用中选择或重新授权会议目录。" } }
      }
    },
    "actionButton.result.interrupted" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Choose whether to continue the interrupted meeting or start a new one." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "请选择继续中断的会议，或保存后开始新会议。" } }
      }
    },
    "actionButton.result.microphone" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Allow microphone access in the app before recording." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "请先在应用中允许麦克风访问。" } }
      }
    },
    "actionButton.result.notice" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Review the recording notice in the app to continue." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "请在应用中确认录音说明后继续。" } }
      }
    },
    "actionButton.result.retry" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Recording could not start. Review the app and try again." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "录音无法开始，请检查应用后重试。" } }
      }
    },
    "actionButton.result.started" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Recording started." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "录音已开始。" } }
      }
    },
    "actionButton.result.starting" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Recording is already starting." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "录音正在启动。" } }
      }
    },
    "actionButton.result.storage" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Free some device storage before recording." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "请释放设备存储空间后再录音。" } }
