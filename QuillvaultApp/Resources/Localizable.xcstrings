    "minutes.recovery.access.description" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Choose the same folder again to renew access. Quillvault will not switch folders automatically." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "请重新选择原目录以恢复访问。Quillvault 不会自动切换到其他目录。" } }
