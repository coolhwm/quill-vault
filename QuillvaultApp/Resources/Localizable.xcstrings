    "actionButton.start.description" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Open Quillvault and start a face-to-face meeting recording." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "打开墨匣并开始面对面会议录音。" } }
