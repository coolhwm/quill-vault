    "recording.failure.generic" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Recording could not be completed. Existing audio has not been overwritten." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "录音操作未能完成，已有音频不会被覆盖。" } }
      }
    },
    "recording.failure.transcription.assets" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Speech assets are not ready. Connect to the network and retry; the recording is safe." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "语音识别资源尚未就绪，请联网后重试；录音已安全保留。" } }
      }
    },
    "recording.failure.transcription.generic" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The transcript could not be completed. The recording is safe and can be retried." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "逐字稿未能完成；录音已安全保留，可重试生成。" } }
      }
    },
    "recording.failure.transcription.locale" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "This transcription language is unavailable on this device. The recording is safe." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "此设备不支持当前转写语言；录音已安全保留。" } }
      }
    },
    "recording.failure.transcription.publish" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The transcript could not be published safely. The recording is safe; retry to finish." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "逐字稿未能安全发布；录音已保留，请重试完成。" } }
      }
    },
    "recording.failure.invalid" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The audio file did not pass duration and packet validation. Keep the app open and retry." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "音频未通过时长与音频包校验，请保持 App 打开并重试。" } }
      }
    },
    "recording.failure.permission" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Allow microphone access in Settings before recording." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "请先在系统设置中允许麦克风访问。" } }
