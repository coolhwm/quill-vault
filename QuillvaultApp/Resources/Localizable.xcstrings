        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "该目录尚未下载到本机，请先在“文件”中下载，然后重新检查。" } }
      }
    },
    "home.directory.unavailable" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The meeting folder is temporarily unavailable. Check again before recording." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "会议目录暂不可用，请重新检查后再录音。" } }
