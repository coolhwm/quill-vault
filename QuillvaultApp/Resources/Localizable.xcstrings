      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Start Meeting" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "开始会议录音" } }
      }
    },
    "actionButton.start.title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Start a Face-to-Face Meeting" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "开始面对面会议" } }
      }
    },
    "home.empty.description" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Recording will be available from the primary action on this screen." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "面对面会话将从本页主操作快速开始。" } }
      }
