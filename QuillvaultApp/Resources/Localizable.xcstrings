{
  "sourceLanguage" : "en",
  "strings" : {
    "home.empty.description" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Recording will be available from the primary action on this screen." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "面对面会话将从本页主操作快速开始。" } }
      }
    },
    "home.empty.title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Ready for your next meeting" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "准备记录下一场会议" } }
      }
    },
    "home.subtitle" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Your meetings remain yours." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "会议文件始终由你掌握。" } }
      }
    },
    "home.recording.description" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Audio is saved first. AI, network, and transcription never block recording." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "音频优先保存；AI、网络和转写不会阻止录音开始。" } }
      }
    },
    "home.recording.title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Record a meeting" } },
