    },
    "home.directory.reauthorize" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Reauthorize Meeting Folder" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "重新授权会议目录" } }
      }
    },
    "home.directory.retry" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Check Folder Again" } },
