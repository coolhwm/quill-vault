        "en" : { "stringUnit" : { "state" : "translated", "value" : "Choose a folder before recording. Quillvault will not create a private fallback." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "录音前请选择目录；Quillvault 不会创建私有回退副本。" } }
