{
  "sourceLanguage": "en",
  "strings": {
    "actionButton.result.alreadyActive": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording is already active."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音已经在进行中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "錄音已经在進行中。"
          }
        }
      }
    },
    "actionButton.result.cancelled": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording was not started."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音未开始。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "錄音未開始。"
          }
        }
      }
    },
    "actionButton.result.directory": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose or reauthorize the meeting folder in the app."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在应用中选择或重新授权会议目录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在应用中選擇或重新授權會議目錄。"
          }
        }
      }
    },
    "actionButton.result.interrupted": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose whether to continue the interrupted meeting or start a new one."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请选择继续中断的会议，或保存后开始新会议。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請選擇继續中斷的會議，或儲存後開始新會議。"
          }
        }
      }
    },
    "actionButton.result.microphone": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow microphone access in the app before recording."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先在应用中允许麦克风访问。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先在应用中允许麦克风訪問。"
          }
        }
      }
    },
    "actionButton.result.notice": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review the recording notice in the app to continue."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在应用中确认录音说明后继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在应用中確認錄音说明後继續。"
          }
        }
      }
    },
    "actionButton.result.retry": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording could not start. Review the app and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音无法开始，请检查应用后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "錄音无法開始，請檢查应用後重試。"
          }
        }
      }
    },
    "actionButton.result.started": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording started."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音已开始。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "錄音已開始。"
          }
        }
      }
    },
    "actionButton.result.starting": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording is already starting."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音正在启动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "錄音正在啟動。"
          }
        }
      }
    },
    "actionButton.result.storage": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free some device storage before recording."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请释放设备存储空间后再录音。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請释放設備存储空間後再錄音。"
          }
        }
      }
    },
    "actionButton.start.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Quillvault and start a face-to-face meeting recording."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开墨匣并开始面对面会议录音。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "打開墨匣并開始面對面會議錄音。"
          }
        }
      }
    },
    "actionButton.start.shortTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start Meeting"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始会议录音"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開始會議錄音"
          }
        }
      }
    },
    "actionButton.start.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start a Face-to-Face Meeting"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始面对面会议"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開始面對面會議"
          }
        }
      }
    },
    "brand.name": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quillvault"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "墨匣"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "墨匣"
          }
        }
      }
    },
    "common.cancel": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        }
      }
    },
    "common.ok": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OK"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "好"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "好"
          }
        }
      }
    },
    "common.save": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存"
          }
        }
      }
    },
    "home.directory.access.expired": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Folder access has expired. Reauthorize it before recording."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目录授权已失效，请重新授权后再录音。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目錄授權已失效，請重新授權後再錄音。"
          }
        }
      }
    },
    "home.directory.checking": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checking meeting folder access…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在检查会议目录访问权限…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在檢查會議目錄訪問權限…"
          }
        }
      }
    },
    "home.directory.choose": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose Meeting Folder"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择会议目录"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇會議目錄"
          }
        }
      }
    },
    "home.directory.download.required": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This folder is not available offline. Download it in Files, then check again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该目录尚未下载到本机，请先在“文件”中下载，然后重新检查。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "该目錄尚未下載到本机，請先在“文件”中下載，然後重新檢查。"
          }
        }
      }
    },
    "home.directory.reauthorize": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reauthorize Meeting Folder"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新授权会议目录"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重新授權會議目錄"
          }
        }
      }
    },
    "home.directory.required": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a folder before recording. Quillvault will not create a private fallback."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音前请选择目录；Quillvault 不会创建私有回退副本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "錄音前請選擇目錄；Quillvault 不會创建私有回退副本。"
          }
        }
      }
    },
    "home.directory.retry": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check Folder Again"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新检查目录"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重新檢查目錄"
          }
        }
      }
    },
    "home.directory.unavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The meeting folder is temporarily unavailable. Check again before recording."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会议目录暂不可用，请重新检查后再录音。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "會議目錄暫不可用，請重新檢查後再錄音。"
          }
        }
      }
    },
    "home.empty.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording will be available from the primary action on this screen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "面对面会话将从本页主操作快速开始。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "面對面會話将从本頁主操作快速開始。"
          }
        }
      }
    },
    "home.empty.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ready for your next meeting"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "准备记录下一场会议"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "准備記錄下一场會議"
          }
        }
      }
    },
    "home.processing.minutes.completed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Minutes ready"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "纪要已完成"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "紀要已完成"
          }
        }
      }
    },
    "home.processing.minutes.completed.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Minutes are available in the meeting library."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "纪要已写入会议资产，可在纪要列表中查看。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "紀要已写入會議资产，可在紀要列表中查看。"
          }
        }
      }
    },
    "home.processing.minutes.failed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Minutes generation failed"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "纪要生成失败"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "紀要生成失敗"
          }
        }
      }
    },
    "home.processing.minutes.failed.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording and transcript are safe. You can try generating again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音和文字记录仍安全；可以重新生成纪要。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "錄音和文字記錄仍安全；可以重新生成紀要。"
          }
        }
      }
    },
    "home.processing.minutes.pause.credentials": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Model credentials are unavailable. Check your model profile."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模型凭据不可用，请检查模型配置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "模型凭据不可用，請檢查模型配置。"
          }
        }
      }
    },
    "home.processing.minutes.pause.network": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Network is unavailable. Generation can resume later."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网络不可用，稍后可继续生成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "網路不可用，稍後可继續生成。"
          }
        }
      }
    },
    "home.processing.minutes.pause.service": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The model service paused generation. You can resume later."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模型服务暂停了生成，稍后可继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "模型服务暫停了生成，稍後可继續。"
          }
        }
      }
    },
    "home.processing.minutes.paused": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Minutes generation paused"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "纪要生成已暂停"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "紀要生成已暫停"
          }
        }
      }
    },
    "home.processing.minutes.paused.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Generation paused. Existing recording and transcript are safe."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "生成已暂停；录音和文字记录仍安全保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "生成已暫停；錄音和文字記錄仍安全保留。"
          }
        }
      }
    },
    "home.processing.minutes.pending": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Minutes pending"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "待生成纪要"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "待生成紀要"
          }
        }
      }
    },
    "home.processing.minutes.pending.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcript is ready. Start minutes when you are ready."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文字记录已就绪，可在需要时生成纪要。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "文字記錄已就绪，可在需要時生成紀要。"
          }
        }
      }
    },
    "home.processing.minutes.running": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Generating minutes…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "纪要生成中…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "紀要生成中…"
          }
        }
      }
    },
    "home.processing.minutes.running.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Minutes generation is running. You can open details to review the recording and transcript."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "纪要正在生成。可打开详情查看录音和文字记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "紀要正在生成。可打開詳情查看錄音和文字記錄。"
          }
        }
      }
    },
    "home.processing.minutes.stage.completed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Completed"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已完成"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已完成"
          }
        }
      }
    },
    "home.processing.minutes.stage.normalizing": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Normalizing"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "规范化中"
          }
        },
        "zh-Hant": {
