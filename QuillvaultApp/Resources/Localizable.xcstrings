    "home.subtitle" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Your meetings remain yours." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "会议文件始终由你掌握。" } }
      }
    },
    "home.recording.description" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Audio is saved first. AI, network, and transcription never block recording." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "音频优先保存；AI、网络和转写不会阻止录音开始。" } }
      }
    },
    "home.recording.title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Record a meeting" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "记录面对面会议" } }
      }
    },
    "home.directory.checking" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Checking meeting folder access…" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正在检查会议目录访问权限…" } }
